{
  "mcpServers": {
    "brain": {
      "url": "https://brain.888521.top/mcp",
      "bearerTokenEnv": "SECOND_BRAIN_TOKEN",
      "headers": {
        "Authorization": "Bearer ${SECOND_BRAIN_TOKEN}"
      },
      "exposure": "direct",
      "description": "Second-brain memory store: save, search, link, and recall durable notes"
    },
    "zai-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@z_ai/mcp-server@latest"
      ],
      "env": {
        "Z_AI_API_KEY": "!python3 -c 'import json,os;print(json.load(open(os.path.expanduser(\"~/.pi/agent/auth.json\")))[\"zai-coding-cn\"][\"key\"])'",
        "Z_AI_MODE": "ZHIPU",
        "NODE_USE_ENV_PROXY": "1"
      },
      "exposure": "deferred",
      "description": "Vision tools: screenshot OCR, UI-to-code, error diagnosis, diagram and chart analysis, video analysis"
    },
    "web-search-prime": {
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "!python3 -c 'import json,os;print(\"Bearer \"+json.load(open(os.path.expanduser(\"~/.pi/agent/auth.json\")))[\"zai-coding-cn\"][\"key\"])'"
      },
      "exposure": "direct",
      "description": "Web search returning titles, URLs, and page summaries"
    },
    "web-reader": {
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "!python3 -c 'import json,os;print(\"Bearer \"+json.load(open(os.path.expanduser(\"~/.pi/agent/auth.json\")))[\"zai-coding-cn\"][\"key\"])'"
      },
      "exposure": "direct",
      "description": "Fetch a URL and convert page content to markdown"
    },
    "zread": {
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "!python3 -c 'import json,os;print(\"Bearer \"+json.load(open(os.path.expanduser(\"~/.pi/agent/auth.json\")))[\"zai-coding-cn\"][\"key\"])'"
      },
      "exposure": "direct",
      "description": "Search GitHub repo docs/issues/commits, read files, list directory structure"
    },
    "mysetup": {
      "url": "https://mysetup.ai/mcp",
      "description": "mysetup.ai: browse community AI setups, compare with yours, prepare drafts (read-only scope)",
      "oauth": {
        "scope": "setup:read"
      }
    }
  }
}