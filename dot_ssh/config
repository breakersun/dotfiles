# Windows-era proxy command (connect.exe) — dead on Linux, kept for reference
Host oldhome-d1    #Added by lazyssh
    HostName 192.168.123.1
    User admin
    Port 22
    ProxyCommand "C:\Program Files\Git\mingw64\bin\connect.exe" -S 127.0.0.1:10808 %h %p
    IdentityFile ~/.ssh/sunlong

Host github.com
    HostName ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ProxyCommand nc -X connect -x 127.0.0.1:7890 %h %p

Host github.work
    HostName github.com
    User git
    IdentityFile ~/.ssh/sunlong-work
    IdentitiesOnly yes

Host workhorse    #Added by lazyssh (ported from Windows 2026-10-06)
    HostName 10.84.4.80
    User omni
    Port 3021
    IdentityFile ~/.ssh/sunlong
    # FlClash TUN RSTs the large sntrup761 KEX reply; drop PQ KEX until Clash DIRECT rule 10.0.0.0/8 lands (2026-09-23)
